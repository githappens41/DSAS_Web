@model DashboardViewModel

<div class="stats-row">
    
    <a asp-controller="Dashboard" asp-action="Index" class="stat-card" style="text-decoration: none; color: inherit;">
        <div class="value">@Model.Submitted</div>
        <div class="label">Submitted</div>
    </a>

   
    <a asp-controller="Dashboard" asp-action="Index" asp-route-status="Pending" class="stat-card" style="text-decoration: none; color: inherit;">
        <div class="value">@Model.Pending</div>
        <div class="label">Pending</div>
    </a>

    
    <a asp-controller="Dashboard" asp-action="Index" asp-route-status="Approved" class="stat-card" style="text-decoration: none; color: inherit;">
        <div class="value">@Model.Approved</div>
        <div class="label">Approved</div>
    </a>

    
    <a asp-controller="Dashboard" asp-action="Index" asp-route-status="Rejected" class="stat-card" style="text-decoration: none; color: inherit;">
        <div class="value">@Model.Rejected</div>
        <div class="label">Rejected</div>
    </a>
</div>

<form asp-controller="Dashboard" asp-action="Index" method="get" class="search-row">
    <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by student number or name" />
    <select name="status">
        <option value="">All statuses</option>
        <option value="Pending" selected="@(Model.StatusFilter == "Pending" ? "selected" : null)">Pending</option>
        <option value="Approved" selected="@(Model.StatusFilter == "Approved" ? "selected" : null)">Approved</option>
        <option value="Rejected" selected="@(Model.StatusFilter == "Rejected" ? "selected" : null)">Rejected</option>
    </select>
    <button type="submit" class="btn-link">Filter</button>
</form>

<table class="data-table">
    <thead>
        <tr>
            <th>Student Initials &amp; Surname</th>
            <th>Student No</th>
            <th>Submitted</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Registrations)
        {
            var initials = !string.IsNullOrEmpty(r.FullName)
            ? $"{r.FullName[0]}. {r.FullName.Split(' ').LastOrDefault()}"
            : "Unknown";

            <tr>
                <td>@initials</td>
                <td>@(r.StudentNumber ?? "-")</td>
                <td>@(r.SubmittedDate?.ToString("dd MMM") ?? "-")</td>
                <td><span class="badge badge-@r.Status.ToLower()">@r.Status</span></td>
                <td>
                    <div class="action-links">
                        <a asp-controller="Registrations" asp-action="Details" asp-route-id="@r.RegistrationId">Details</a>
                        <a asp-controller="Registrations" asp-action="Details" asp-route-id="@r.RegistrationId">Edit</a>
                        <form asp-controller="Registrations" asp-action="Delete" asp-route-id="@r.RegistrationId" method="post" class="inline-form" onsubmit="return confirm('Delete this registration?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-link-delete">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
