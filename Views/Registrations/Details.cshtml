@model DSAS.Web.Models.RegistrationDetailViewModel
@{
    ViewData["Title"] = "Application Review";
    var reg = Model.Registration;

    // Construct the public storage URLs
    var baseUrl = ViewBag.SupabaseUrl;
    var bucketUrl = $"{baseUrl}/storage/v1/object/public/student-uploads/";
    var photoUrl = string.IsNullOrEmpty(reg.PhotoUrl) ? "" : $"{bucketUrl}{reg.PhotoUrl}";
}

<div class="review-wrapper">
    <div class="review-header">
        <h2>Application Review</h2>
        <h3>Student Information</h3>
    </div>

    <div class="review-content">
        <!-- Left Column: Details -->
        <div class="details-column">
            <div class="detail-group">
                <span class="detail-label">Full Name</span>
                <span class="detail-value">@reg.FullName</span>
            </div>

            <div class="detail-row-inline">
                <div class="detail-group">
                    <span class="detail-label">Student Number</span>
                    <span class="detail-value">@reg.StudentNumber</span>
                </div>
                <div class="detail-group">
                    <span class="detail-label">Programme</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(reg.Programme) ? "N/A" : reg.Programme)</span>
                </div>
            </div>

            <div class="detail-row-inline">
                <div class="detail-group">
                    <span class="detail-label">Date submitted</span>
                    <span class="detail-value">@(reg.SubmittedDate?.ToString("dd MMM") ?? "N/A")</span>
                </div>
                <div class="detail-group">
                    <span class="detail-label">Current status</span>
                    <span class="status-badge">@reg.Status</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(reg.RejectionReason))
            {
                <div class="detail-group mt-3">
                    <span class="detail-label text-danger">Rejection Reason</span>
                    <span class="detail-value text-danger">@reg.RejectionReason</span>
                </div>
            }
        </div>

        <!-- Right Column: Photo -->
        <div class="photo-column">
            @if (!string.IsNullOrEmpty(photoUrl))
            {
                <img src="@photoUrl" alt="Student Photo" class="student-photo" />
            }
            else
            {
                <div class="no-photo">No Photo</div>
            }
            <span class="photo-label">Student Photo</span>
        </div>
    </div>

    <!-- Action Buttons (Only show if Pending) -->
    @if (reg.Status.ToLower() == "pending")
    {
        <div class="action-buttons">
            <form asp-action="Approve" asp-route-id="@reg.RegistrationId" method="post" class="form-half">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-approve">Approve</button>
            </form>

            <form asp-action="Reject" asp-route-id="@reg.RegistrationId" method="post" class="form-half d-flex">
                @Html.AntiForgeryToken()
                <input type="text" name="Reason" class="form-control me-2" placeholder="Reason for rejection..." required />
                <button type="submit" class="btn-reject">Reject</button>
            </form>
        </div>
    }
</div>